import pandas as pd
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim

# ==========================================
# 0. Device Configuration (Mac GPU Setup)
# ==========================================
if torch.backends.mps.is_available():
    device = torch.device("mps")
    print("🚀 Using Apple Silicon GPU acceleration (MPS)")
elif torch.cuda.is_available():
    device = torch.device("cuda")
    print("🚀 Using Nvidia GPU acceleration (CUDA)")
else:
    device = torch.device("cpu")
    print("⚠️ GPU backend not found, falling back to CPU")

# ==========================================
# 1. Load Data
# ==========================================
df = pd.read_csv('Lorentz_attractor50_1.csv')
data = df[['X', 'Y', 'Z']].values # Shape: (51, 3)
N = len(data)

# ==========================================
# 2. Define the Graph Convolutional Network
# ==========================================
class GCNLayer(nn.Module):
    def __init__(self, in_features, out_features):
        super(GCNLayer, self).__init__()
        self.linear = nn.Linear(in_features, out_features)

    def forward(self, x, adj):
        support = self.linear(x)
        return torch.matmul(adj, support)

class TimeSeriesGCN(nn.Module):
    def __init__(self):
        super(TimeSeriesGCN, self).__init__()
        self.gcn1 = GCNLayer(3, 16)
        self.relu = nn.ReLU()
        self.gcn2 = GCNLayer(16, 3)

    def forward(self, x, adj):
        x = self.gcn1(x, adj)
        x = self.relu(x)
        x = self.gcn2(x, adj)
        return x

# ==========================================
# 3. Create Graph Adjacency Matrix (Training)
# ==========================================
def create_line_graph_adjacency(num_nodes):
    adj = np.zeros((num_nodes, num_nodes))
    for i in range(num_nodes):
        if i > 0: adj[i, i-1] = 1
        if i < num_nodes-1: adj[i, i+1] = 1
    
    adj += np.eye(num_nodes)
    deg = np.sum(adj, axis=1)
    d_inv_sqrt = np.power(deg, -0.5)
    d_inv_sqrt[np.isinf(d_inv_sqrt)] = 0.
    d_mat_inv_sqrt = np.diag(d_inv_sqrt)
    return d_mat_inv_sqrt @ adj @ d_mat_inv_sqrt

adj_train_norm = create_line_graph_adjacency(N)

# Convert tensors and explicitly push them to the configured GPU device
x_train_tensor = torch.FloatTensor(data).to(device)
adj_train_tensor = torch.FloatTensor(adj_train_norm).to(device)

# ==========================================
# 4. Train the Model
# ==========================================
# Instantiate the model and push all internal weights/parameters to the GPU
model = TimeSeriesGCN().to(device)
optimizer = optim.Adam(model.parameters(), lr=0.01)
criterion = nn.MSELoss()

print("Training GCN on GPU...")
for epoch in range(1000):
    model.train()
    optimizer.zero_grad()
    
    # Forward pass calculations run inside the GPU
    out = model(x_train_tensor, adj_train_tensor)
    
    loss = criterion(out, x_train_tensor)
    loss.backward()
    optimizer.step()
    
    if epoch % 200 == 0:
        print(f"Epoch {epoch} | Loss: {loss.item():.4f}")

# ==========================================
# 5. Inference: Generate 0.5s Dataset
# ==========================================
N_new = 2 * N - 1 
adj_test_norm = create_line_graph_adjacency(N_new)

# Push the expanded graph topology to the GPU
adj_test_tensor = torch.FloatTensor(adj_test_norm).to(device)

x_test = np.zeros((N_new, 3))
for i in range(N):
    x_test[i*2] = data[i] 
for i in range(N-1):
    x_test[i*2 + 1] = (data[i] + data[i+1]) / 2.0 

# Push the initialization feature tensor to the GPU
x_test_tensor = torch.FloatTensor(x_test).to(device)

model.eval()
with torch.no_grad():
    out_new = model(x_test_tensor, adj_test_tensor)

# CRITICAL: Send the tensor back to the CPU memory space before converting to numpy
out_new_np = out_new.cpu().numpy()

# Enforce that the original 1.0s points remain exactly the same as the ground truth
for i in range(N):
    out_new_np[i*2] = data[i]

# Export to new CSV
time_s_new = np.arange(0, 50.5, 0.5)
df_new = pd.DataFrame({
    'Time_s': time_s_new,
    'X': out_new_np[:, 0],
    'Y': out_new_np[:, 1],
    'Z': out_new_np[:, 2]
})

output_file = 'Lorentz_attractor50_0_5.csv'
df_new.to_csv(output_file, index=False)
print(f"\nSuccess! New dataset saved as: {output_file}")